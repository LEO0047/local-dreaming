{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "no_op": {"type": "boolean"},
    "dispositions": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "candidate_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "reason": {
            "type": "string",
            "enum": [
              "semantic_duplicate",
              "stale_status",
              "operations_only",
              "insufficient_evidence",
              "not_durable"
            ]
          },
          "rationale": {"type": "string", "minLength": 1, "maxLength": 1000}
        },
        "required": ["candidate_id", "reason", "rationale"],
        "additionalProperties": false
      }
    },
    "proposals": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "proposal_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "operation": {
            "type": "string",
            "enum": ["ADD", "UPDATE", "SUPERSEDE", "DISPUTE", "NARROW"]
          },
          "candidate_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1, "maxLength": 128}
          },
          "claim_id": {"type": ["string", "null"], "maxLength": 128},
          "expected_head_set_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "subject": {"type": "string", "minLength": 1, "maxLength": 500},
          "predicate": {"type": "string", "minLength": 1, "maxLength": 200},
          "scope": {"type": "string", "minLength": 1, "maxLength": 200},
          "proposed_value": {"type": "string", "minLength": 1, "maxLength": 4000},
          "proposed_summary": {"type": "string", "minLength": 1, "maxLength": 2000},
          "epistemic_status": {
            "type": "string",
            "enum": [
              "observed",
              "verified",
              "provisional",
              "uncertain",
              "historical",
              "user_confirmed"
            ]
          },
          "valid_from": {"type": ["string", "null"], "maxLength": 64},
          "valid_to": {"type": ["string", "null"], "maxLength": 64},
          "rationale": {"type": "string", "minLength": 1, "maxLength": 2000}
        },
        "required": [
          "proposal_id",
          "operation",
          "candidate_ids",
          "claim_id",
          "expected_head_set_hash",
          "subject",
          "predicate",
          "scope",
          "proposed_value",
          "proposed_summary",
          "epistemic_status",
          "valid_from",
          "valid_to",
          "rationale"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["no_op", "proposals", "dispositions"],
  "additionalProperties": false
}
